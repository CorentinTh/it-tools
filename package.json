{
  "name": "it-tools",
  "type": "module",
  "version": "2.1.0",
  "packageManager": "pnpm@9.11.0",
  "description": "Collection of handy online tools for developers, with great UX. ",
  "author": "Corentin Th <corentin.thomasset74+it-tools@gmail.com> (https://corentin.tech)",
  "license": "GNU GPLv3",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "9.11.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.7",
      "@babel/helpers": "7.29.7",
      "@babel/runtime": "7.29.7",
      "brace-expansion": "1.1.18",
      "fast-uri": "3.1.5",
      "ip-address": "10.5.0",
      "linkify-it": "5.0.2",
      "node-forge": "1.4.0",
      "lodash-es": "4.18.1",
      "minimatch@<3.1.3": "3.1.5",
      "nanoid": "3.3.18",
      "postcss": "8.5.26",
      "prosemirror-markdown": "1.13.6",
      "uuid": "13.0.1"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/64mb/it-tools"
  },
  "keywords": [
    "productivity",
    "converter",
    "website",
    "vuejs",
    "tools",
    "frontend",
    "tool",
    "developer-tools",
    "developer-productivity"
  ],
  "scripts": {
    "dev": "vite",
    "dev:fresh": "vite --force",
    "build": "node scripts/generate-oui-data.mjs --check && node scripts/generate-geoip-data.mjs --check && node scripts/generate-tool-registry.mjs --check && pnpm typecheck && node --max-old-space-size=4096 node_modules/vite/bin/vite.js build",
    "build:standalone": "node scripts/generate-oui-data.mjs --check && node scripts/generate-geoip-data.mjs --check && node scripts/generate-tool-registry.mjs --check && pnpm typecheck && node --max-old-space-size=8192 scripts/build-standalone.mjs",
    "build:stats": "node scripts/build-stats.mjs",
    "build:stats:check": "node scripts/build-stats.mjs --budgets .ai/baselines/build-budgets.json",
    "build:stats:update": "node scripts/build-stats.mjs --output .ai/baselines/build-stats.json",
    "container:build": "docker build --tag it-tools:smoke .",
    "preview": "vite preview",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --environment jsdom",
    "test:unit:watch": "vitest --environment jsdom",
    "test:build-stats": "node --test scripts/build-stats.test.mjs scripts/generate-tool-registry.test.mjs",
    "test:oui-data": "node --test scripts/generate-oui-data.test.mjs && node scripts/generate-oui-data.mjs --check",
    "test:geoip-data": "node scripts/generate-geoip-data.mjs --check",
    "test:container": "sh scripts/container-smoke.sh it-tools:smoke",
    "test:container:subpath": "sh scripts/subpath-container-smoke.sh it-tools:subpath-smoke",
    "test:security": "pnpm audit --prod --audit-level high",
    "test:standalone": "node --test scripts/standalone-build.test.mjs && pnpm build:standalone && STANDALONE_TEST=true NO_WEB_SERVER=true playwright test src/standalone.e2e.spec.ts --project=chromium --project=firefox --project=webkit --reporter=line --workers=1",
    "test:e2e": "playwright test",
    "test:e2e:dev": "BASE_URL=http://127.0.0.1:8091 NO_WEB_SERVER=true playwright test",
    "test:dev-runtime": "node scripts/dev-runtime-smoke.mjs",
    "coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false && vue-tsc --noEmit -p tsconfig.vite-config.json --composite false",
    "lint": "eslint src --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-path .gitignore --ignore-pattern 'src/tools/mac-address-lookup/data/**/*.json'",
    "generate:oui-data": "node scripts/generate-oui-data.mjs",
    "generate:tool-registry": "node scripts/generate-tool-registry.mjs",
    "script:create:tool": "node scripts/create-tool.mjs",
    "script:create:ui": "hygen generator ui-component",
    "release": "node ./scripts/release.mjs"
  },
  "dependencies": {
    "@it-tools/bip39": "^0.0.4",
    "@it-tools/oggen": "^1.3.0",
    "@noble/hashes": "2.2.0",
    "@regexper/render": "^1.0.0",
    "@sindresorhus/slugify": "^2.2.1",
    "@tabler/icons-vue": "^3.20.0",
    "@tiptap/pm": "2.1.6",
    "@tiptap/starter-kit": "2.1.6",
    "@tiptap/vue-3": "2.0.3",
    "@vicons/material": "^0.12.0",
    "@vicons/tabler": "^0.12.0",
    "@vueuse/core": "^10.3.0",
    "@vueuse/router": "^10.0.0",
    "ajv": "8.20.0",
    "bcryptjs": "^2.4.3",
    "change-case": "^4.1.2",
    "colord": "^2.9.3",
    "composerize-ts": "^0.6.2",
    "country-code-lookup": "^0.1.0",
    "cron-validator": "^1.3.1",
    "cronstrue": "^2.26.0",
    "crypto-js": "4.2.0",
    "date-fns": "^2.29.3",
    "dompurify": "3.4.13",
    "email-normalizer": "^1.0.0",
    "emojilib": "4.0.3",
    "figlet": "^1.7.0",
    "figue": "^1.2.0",
    "fuse.js": "^6.6.2",
    "hash-wasm": "4.12.0",
    "highlight.js": "^11.7.0",
    "hyparquet": "1.28.2",
    "iarna-toml-esm": "^3.0.5",
    "ibantools": "^4.3.3",
    "js-base64": "^3.7.6",
    "json5": "^2.2.3",
    "jsonc-parser": "3.2.0",
    "jwt-decode": "^3.1.2",
    "libphonenumber-js": "^1.10.28",
    "lodash": "4.18.1",
    "markdown-it": "14.2.0",
    "marked": "^10.0.0",
    "mathjs": "^11.9.1",
    "mermaid": "10.9.8",
    "mime-types": "^2.1.35",
    "monaco-editor": "^0.43.0",
    "naive-ui": "^2.35.0",
    "netmask": "^2.0.2",
    "pdf-signature-reader": "^1.4.3",
    "pinia": "^2.0.34",
    "pkijs": "3.4.0",
    "plausible-tracker": "^0.3.8",
    "qrcode": "^1.5.1",
    "randexp": "^0.5.3",
    "saxen": "11.1.1",
    "sql-formatter": "^13.0.0",
    "ua-parser-js": "^1.0.35",
    "ulid": "^2.3.0",
    "unicode-emoji-json": "0.9.0",
    "uuid": "13.0.1",
    "vue": "^3.3.4",
    "vue-i18n": "9.14.5",
    "vue-router": "^4.1.6",
    "vue-shadow-dom": "^4.2.0",
    "xml-formatter": "^3.3.2",
    "xml-js": "^1.6.11",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^0.41.0",
    "@iconify-json/mdi": "^1.1.50",
    "@intlify/unplugin-vue-i18n": "^2.0.0",
    "@playwright/test": "1.62.1",
    "@rushstack/eslint-patch": "^1.2.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/crypto-js": "^4.1.1",
    "@types/dompurify": "^3.0.5",
    "@types/figlet": "^1.5.8",
    "@types/jsdom": "^21.0.0",
    "@types/lodash": "^4.14.192",
    "@types/markdown-it": "^13.0.7",
    "@types/mime-types": "^2.1.1",
    "@types/netmask": "^2.0.0",
    "@types/node": "^18.15.11",
    "@types/qrcode": "^1.5.0",
    "@types/ua-parser-js": "^0.7.36",
    "@unocss/eslint-config": "^0.57.0",
    "@vitejs/plugin-vue": "^4.3.2",
    "@vitejs/plugin-vue-jsx": "^3.0.2",
    "@vue/compiler-sfc": "^3.2.47",
    "@vue/runtime-dom": "^3.3.4",
    "@vue/test-utils": "^2.3.2",
    "@vue/tsconfig": "^0.4.0",
    "consola": "^3.0.2",
    "esbuild": "0.18.20",
    "eslint": "^8.47.0",
    "fake-indexeddb": "6.2.4",
    "hygen": "^6.2.11",
    "jsdom": "^22.0.0",
    "less": "^4.1.3",
    "oui-data": "^1.0.10",
    "prettier": "^3.0.0",
    "typescript": "~5.2.0",
    "unocss": "^0.65.1",
    "unocss-preset-scrollbar": "^0.2.1",
    "unplugin-auto-import": "^0.16.4",
    "unplugin-icons": "^0.17.0",
    "unplugin-vue-components": "^0.25.0",
    "unplugin-vue-markdown": "32.0.0",
    "vite": "^4.4.9",
    "vite-plugin-pwa": "^0.16.0",
    "vite-svg-loader": "^4.0.0",
    "vitest": "^0.34.0",
    "vue-tsc": "^1.8.1",
    "workbox-window": "^7.0.0",
    "zx": "^7.2.1"
  }
}
